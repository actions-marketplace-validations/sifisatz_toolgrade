{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --dir .. build && pnpm db:migrate && pnpm exec next build",
  "crons": [
    { "path": "/api/cron/retention-cleanup", "schedule": "0 3 * * *" }
  ]
}
